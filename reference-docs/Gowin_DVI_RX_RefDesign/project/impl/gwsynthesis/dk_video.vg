  O_tmds_clk_p,
  O_tmds_clk_n,
  O_tmds_data_p,
  O_tmds_data_n
)
;
input I_rst_n_d;
input rx0_pclk;
input rx0_de;
input rx0_vsync;
input rx0_hsync;
input [7:0] rx0_r;
input [7:0] rx0_g;
input [7:0] rx0_b;
output O_tmds_clk_p;
output O_tmds_clk_n;
output [2:0] O_tmds_data_p;
output [2:0] O_tmds_data_n;
wire VCC;
wire GND;
  \~rgb2dvi.DVI_TX_Top  rgb2dvi_inst (
    .I_rst_n_d(I_rst_n_d),
    .rx0_pclk(rx0_pclk),
    .rx0_de(rx0_de),
    .rx0_vsync(rx0_vsync),
    .rx0_hsync(rx0_hsync),
    .rx0_r(rx0_r[7:0]),
    .rx0_g(rx0_g[7:0]),
    .rx0_b(rx0_b[7:0]),
    .O_tmds_clk_p(O_tmds_clk_p),
    .O_tmds_clk_n(O_tmds_clk_n),
    .O_tmds_data_p(O_tmds_data_p[2:0]),
    .O_tmds_data_n(O_tmds_data_n[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DVI_TX_Top */
